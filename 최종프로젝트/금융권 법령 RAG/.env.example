# 이 파일을 .env 로 복사한 뒤 빈 값을 채운다. .env 는 저장소에 올리지 않는다.

# DB (docker-compose.yml 이 이 값으로 컨테이너를 만든다)
POSTGRES_USER=admin
POSTGRES_PASSWORD=
POSTGRES_DB=law_rag
DB_HOST=127.0.0.1
DB_PORT=5435
# 검색 전용 계정 law_reader 의 비밀번호
LAW_PASSWORD=

# 답변 LLM (OpenAI 호환 API)
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-6-luna

# 데이터를 처음부터 다시 받을 때만: 국가법령정보센터 Open API 인증값
LAW_API_OC=
