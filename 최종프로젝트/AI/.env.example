# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 절대 커밋하지 마세요.

# --- DB (docker-compose 와 파이썬 코드가 함께 사용) ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me-admin
POSTGRES_DB=pii_rag
RAG_PASSWORD=change-me-rag
VAULT_PASSWORD=change-me-vault
DB_HOST=localhost
DB_PORT=5432

# --- 임베딩 ---
# EMBED_PROVIDER=hf    : 로컬 모델 (권장, worklog 17장). EMBED_MODEL=BAAI/bge-m3, EMBED_DIM=1024, EMBED_BATCH=16
#                        외부로 아무것도 안 나감. 첫 실행 때 모델 약 2.3GB 를 Hugging Face 에서 받음. 메모리 약 2.3GB
# EMBED_PROVIDER=api   : OpenAI 호환 임베딩 API (CLOVA Studio bge-m3 등, 마스킹된 텍스트만 전송됨)
# EMBED_PROVIDER=local : API 없이 동작만 확인하는 해시 임베딩 (검색 품질 낮음, 테스트 전용)
EMBED_PROVIDER=local
EMBED_API_BASE=https://api.example.com/v1
EMBED_API_KEY=
EMBED_MODEL=text-embedding-3-small
# DB 테이블 차원과 반드시 같아야 함. 바꾸면 docker compose down -v 후 다시 up
EMBED_DIM=1536
# 요청 1건에 넣을 문장 수. CLOVA Studio(bge-m3 등)는 리스트 입력을 받지 않으므로 1
EMBED_BATCH=64

# --- LLM: 답변·재순위·에이전트 모두 OpenAI gpt-6-luna (worklog 24장) ---
# OpenAI 키. 절대 커밋 금지
OPENAI_API_KEY=
# 추론 강도: none(기본) | low | medium | high | xhigh
# OPENAI_REASONING_EFFORT=none
# ANSWER_REASONING_EFFORT=low    # 답변 LLM 만 (none 이면 빠르지만 "찾을 수 없습니다" 오답이 잦음)
# 모델을 바꾸려면 (기본 모두 gpt-6-luna)
# OPENAI_LLM_MODEL=gpt-6-luna
# OPENAI_RERANK_MODEL=gpt-6-luna
# AGENT_MODEL=gpt-6-luna

# (비교용) CLOVA Studio 로 돌리려면 LLM_PROVIDER=clova + 아래 값
# LLM_PROVIDER=clova
# LLM_API_BASE=https://clovastudio.stream.ntruss.com/v1/openai
# LLM_API_KEY=
# LLM_MODEL=HCX-007

# --- 가명처리 ---
# HMAC 비밀키. 팀에서 임의의 긴 문자열로 정하고 절대 커밋하지 마세요.
HMAC_KEY=

# --- 검색·답변 옵션 (worklog 13·16·17장. 값을 안 쓰면 기본값) ---
# 재순위 (검색 상위 결과를 LLM 으로 다시 정렬)
RERANK=1

# --- 최종프로젝트 추가 ---
# 스프링 → AI 서버 내부 키. 스프링 쪽 설정에도 같은 값. 긴 임의 문자열, 절대 커밋 금지
AI_SERVICE_KEY=
