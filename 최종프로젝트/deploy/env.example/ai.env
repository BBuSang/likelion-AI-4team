# 서버의 /srv/saebom/env/ai.env (git 제외). DB_HOST·DB_PORT 는 compose 가 db:5432 로 정함
POSTGRES_DB=saebom
# db.env 와 같은 값
RAG_PASSWORD=
# db.env 와 같은 값
VAULT_PASSWORD=
# db.env 와 같은 값
LAW_PASSWORD=
# db.env 와 같은 값
NOACTION_PASSWORD=
# backend.env 와 같은 값
AI_SERVICE_KEY=
# 로컬 DB 를 옮겨 오면 가명처리 토큰이 같아야 하므로 로컬과 같은 HMAC_KEY
HMAC_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=openai
OPENAI_LLM_MODEL=gpt-6-luna
OPENAI_RERANK_MODEL=gpt-6-luna
EMBED_PROVIDER=hf
EMBED_MODEL=nlpai-lab/KURE-v1
EMBED_DIM=1024
EMBED_BATCH=16
RERANK=1
LLM_REASONING_EFFORT=none
PII_NAME_MODEL=outputs/models/atonlee-ft-v6
