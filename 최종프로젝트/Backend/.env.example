# Backend/.env 로 복사해서 값 채우기 (커밋 금지)
# DB: infra/.env 의 APP_PASSWORD
DB_PASSWORD=
# 32바이트 이상 아무 문자열
JWT_SECRET=
# AI/.env 의 AI_SERVICE_KEY 와 같은 값
AI_SERVICE_KEY=
# 첫 관리자 (관리자가 없을 때만 만듦, 비밀번호 12자 이상)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# 선택: DB_HOST, DB_PORT(5434), DB_NAME(saebom), DB_USER(app_user), AI_BASE_URL(http://localhost:8000)
