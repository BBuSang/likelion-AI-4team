# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 절대 커밋하지 마세요.
# AI/.env 와 Backend 실행 설정의 DB 비밀번호도 여기와 같아야 합니다.
POSTGRES_USER=admin
POSTGRES_PASSWORD=
POSTGRES_DB=saebom
# 계정별 비밀번호: app(Spring) / rag·vault(AI 서버) / docs(일반 문서 RAG)
APP_PASSWORD=
RAG_PASSWORD=
DOCS_PASSWORD=
VAULT_PASSWORD=
DB_PORT=5434
# 임베딩 차원 (bge-m3 = 1024). 바꾸면 docker compose down -v 후 다시 up
EMBED_DIM=1024
